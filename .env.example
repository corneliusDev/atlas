# Copy to .env, then: docker compose up   ->  http://localhost:3000

# Host folder of .md files, mounted read-only at /vault (Atlas never writes to it).
VAULT_PATH=./samples/vault

# Claude (Anthropic API) writes summaries, topics, link reasons and cluster labels.
# Required unless ATLAS_EMBEDDINGS_ONLY=true.
ANTHROPIC_API_KEY=
ATLAS_LLM_MODEL=claude-opus-5-5
# true = no Anthropic calls (no summaries/topics/reasons/labels); embeddings + links still work.
ATLAS_EMBEDDINGS_ONLY=false

# Host port for the UI (always bound to 127.0.0.1; Atlas has no auth).
ATLAS_WEB_PORT=3000

# --- Optional: use Ollama running natively on the host instead of the ollama container.
# Run `ollama pull nomic-embed-text` on the host, then uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.host-ollama.yml
# HOST_OLLAMA_URL=http://host.docker.internal:11434
